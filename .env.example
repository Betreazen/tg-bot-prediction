# ============================================================================
# Copy this file to .env and fill it in. After that, `docker compose up -d`
# is all you need — migrations run automatically and nothing else is required.
#   cp .env.example .env
# ============================================================================

# --- Required ---------------------------------------------------------------

# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Comma-separated list of admin Telegram user IDs (get yours from @userinfobot).
# Without at least one ID nobody can manage the bot.
ADMIN_IDS=123456789,987654321

# Database password — REQUIRED, no default. Use a long random value, e.g.:
#   openssl rand -hex 24
DB_PASSWORD=change_me_to_a_long_random_secret

# --- Optional (sensible defaults, change only if needed) --------------------

# Database name/user. DB_HOST/DB_PORT are set automatically in docker-compose;
# only change them if you run the bot outside Docker against an external DB.
DB_NAME=prediction_bot
DB_USER=prediction_bot
# DB_HOST=localhost
# DB_PORT=5432

# Scheduler timezone (used for scheduling and all displayed times).
SCHEDULER_TIMEZONE=Europe/Moscow

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Run several copies of this bot on one host? Give each a unique project name
# so their containers/network/volume never collide.
# COMPOSE_PROJECT_NAME=tg-bot-prediction
